code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform vec3 player_pos;
uniform float radius;
uniform float power;
uniform vec4 albedo : source_color;



void vertex() {
// Input:16
	vec3 n_out16p0 = VERTEX;


// Input:19
	float n_out19p0 = 0.0;


// Input:5
	vec3 n_out5p0 = VERTEX;


// TransformVectorMult:4
	mat4 n_in4p0 = mat4(vec4(1.00000, 0.00000, 0.00000, 0.0), vec4(0.00000, 1.00000, 0.00000, 0.0), vec4(0.00000, 0.00000, 1.00000, 0.0), vec4(0.00000, 0.00000, 0.00000, 1.0));
	vec3 n_out4p0 = (n_in4p0 * vec4(n_out5p0, 1.0)).xyz;


// Vector3Parameter:2
	vec3 n_out2p0 = player_pos;


// VectorOp:6
	vec3 n_out6p0 = n_out4p0 - n_out2p0;


// VectorOp:7
	vec3 n_in7p1 = vec3(1.00000, 0.00000, 1.00000);
	vec3 n_out7p0 = n_out6p0 * n_in7p1;


// VectorFunc:8
	vec3 n_out8p0 = normalize(n_out7p0);


// TransformVectorMult:11
	vec3 n_out11p0 = (vec4(n_out8p0, 1.0) * ).xyz;


// Input:13
	vec2 n_out13p0 = UV;


// VectorDecompose:14
	float n_out14p0 = vec3(n_out13p0, 0.0).x;
	float n_out14p1 = vec3(n_out13p0, 0.0).y;
	float n_out14p2 = vec3(n_out13p0, 0.0).z;


// FloatFunc:12
	float n_out12p0 = 1.0 - n_out14p1;


// VectorOp:15
	vec3 n_out15p0 = n_out11p0 * vec3(n_out12p0);


// FloatParameter:20
	float n_out20p0 = radius;


// Distance:9
	float n_out9p0 = distance(n_out2p0, n_out4p0);


// SmoothStep:10
	float n_in10p1 = 0.00000;
	float n_out10p0 = smoothstep(n_out20p0, n_in10p1, n_out9p0);


// VectorOp:18
	vec3 n_out18p0 = n_out15p0 * vec3(n_out10p0);


// FloatParameter:21
	float n_out21p0 = power;


// VectorOp:22
	vec3 n_out22p0 = n_out18p0 * vec3(n_out21p0);


// VectorOp:17
	vec3 n_out17p0 = n_out16p0 + n_out22p0;


// Output:0
	VERTEX = n_out17p0;


}

void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = albedo;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);


}
